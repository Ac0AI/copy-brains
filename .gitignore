# Secrets and local state
.env*
!.env.example
node_modules/
.playwright-mcp/
.DS_Store

# Brain data: commit our derived, cited work (notes, cards, index, manifest).
# Never commit raw third-party content (full transcripts and scraped essays),
# people's photos, or intermediate scrape dumps.
data/brains/*/sources/
data/brains/*/candidates.json
data/brains/*/photo.jpg
data/brains/*/sketch.png
data/brains/*/*.log
