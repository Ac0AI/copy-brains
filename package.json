{
  "name": "copy-brains",
  "version": "0.2.0",
  "description": "A source-backed copy library with original Swedish applications, Hormozi, Cialdini and a Copy Operator skill.",
  "license": "MIT",
  "homepage": "https://github.com/Ac0AI/copy-brains",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ac0AI/copy-brains.git"
  },
  "bugs": {
    "url": "https://github.com/Ac0AI/copy-brains/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "chatgpt",
    "founders",
    "startups",
    "knowledge-base",
    "rag"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch copy/start.ts",
    "start": "tsx copy/start.ts",
    "typecheck": "tsc --noEmit",
    "mcp": "tsx copy/mcp.ts",
    "search": "tsx copy/cli.ts",
    "test": "tsx --test copy/tests/*.test.ts",
    "upstream:start": "tsx server/index.ts",
    "upstream:smoke": "node pipeline/smoke.mjs",
    "smoke": "tsx --test copy/tests/http.test.ts copy/tests/mcp.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.21.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "tsx": "^4.19.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
